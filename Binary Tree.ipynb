   "source": [
    "Maximum Depth of Binary Tree"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "bcce798e",
   "metadata": {
    "vscode": {
     "languageId": "plaintext"
    }
   },
   "outputs": [],
   "source": [
    "def maxDepth(self, root):\n",
    "        if root is None:\n",
    "            return 0\n",
    "\n",
    "        left = self.maxDepth(root.left)\n",
    "        right = self.maxDepth(root.right)\n",
    "\n",
    "        return 1 + max(left, right)"
   ]
  }
 ],
